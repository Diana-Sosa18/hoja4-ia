# Copia este archivo como .env y completa los valores

# Postgres / pgvector
POSTGRES_USER=parachute
POSTGRES_PASSWORD=parachute
POSTGRES_DB=parachute_faqs
POSTGRES_HOST=localhost
# 5433 (no 5432) para no chocar con una instalación nativa de PostgreSQL en el equipo
POSTGRES_PORT=5433

# Anthropic (agente con tool use)
ANTHROPIC_API_KEY=sk-ant-...
